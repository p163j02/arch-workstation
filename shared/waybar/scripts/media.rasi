* {
    font:               "JetBrainsMono Nerd Font Bold 12";
    background-color:   transparent;
    text-color:         #c0caf5;
}

window {
    width:              380px;
    background-color:   #1a1b26;
    border:             1px;
    border-color:       #292e42;
    border-radius:      16px;
    padding:            10px;
}

mainbox {
    spacing:            0;
}

inputbar {
    background-color:   #1e2030;
    border-radius:      10px;
    padding:            10px 14px;
    margin:             0px 0px 8px 0px;
    children:           [prompt];
}

prompt {
    color:              #9ece6a;
}

listview {
    lines:              4;
    spacing:            4px;
    padding:            4px 0px;
}

element {
    border-radius:      10px;
    padding:            10px 14px;
}

element normal.normal {
    background-color:   transparent;
    text-color:         #a9b1d6;
}

element selected.normal {
    background-color:   #3d59a1;
    text-color:         #c0caf5;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
}
