[Unit]
Description=Persistent low-latency dispatcher for Eww Waybar panels
After=graphical-session.target waybar-control-center.service
PartOf=graphical-session.target

[Service]
Environment=GDK_BACKEND=wayland
ExecStart=/usr/bin/python3 %h/.config/eww/control-center/scripts/dispatch-service.py
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
