(defwidget cc-brightness-widget []
 (box :orientation "v" :space-evenly false :spacing 14
  (cc-header :icon "󰃠" :title "Pantallas y luz nocturna")
  (cc-section :text "Brillo · sincronizar pantallas")
  (box :space-evenly false :spacing 12
   (label :class "cc-row-icon" :text "󰃟")
   (scale :hexpand true :min 5 :max 100 :value {cc_brightness.percent} :active {cc_brightness.available} :timeout "12s" :onchange "scripts/backend.py action brightness set {}")
   (label :width 44 :text "${cc_brightness.percent}%"))
  (label :class "cc-secondary" :text "Notebook: ${cc_brightness.percent}%" :xalign 0)
  (label :class "cc-secondary" :text {cc_brightness.external.available ? "Monitor: ${cc_brightness.external.percent}% · DDC/CI" : "Monitor: DDC/CI pendiente"} :xalign 0)
  (cc-error :text {cc_brightness.external.available ? "" : cc_brightness.external.message})
  (box :class "cc-footer" :space-evenly false :spacing 12
   (label :text "Luz nocturna" :hexpand true :xalign 0)
   (button :class {cc_nightlight.warm ? "cc-toggle on" : "cc-toggle"} :active {cc_nightlight.available} :timeout "8s" :onclick "scripts/backend.py action nightlight warm" {cc_nightlight.warm ? "󰨚" : "󰨙"}))
  (box :space-evenly false :spacing 10
   (label :class "cc-row-icon" :text "󰛨")
   (scale :hexpand true :min 2500 :max 6500 :value {cc_nightlight.temperature} :active {cc_nightlight.available} :timeout "8s" :onchange "scripts/backend.py action nightlight temperature {}")
   (label :width 64 :text "${cc_nightlight.temperature} K"))
  (box :space-evenly false
   (label :class "cc-secondary" :text "Más cálida" :hexpand true :xalign 0)
   (label :class "cc-secondary" :text "Más neutra" :xalign 1))
  (button :class "cc-preset" :timeout "8s" :onclick "scripts/backend.py action nightlight temperature 3500" "Restablecer · 3500 K")
  (cc-error :text {cc_brightness.error})
  (cc-error :text {cc_nightlight.error})))
