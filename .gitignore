**/__pycache__/
**/graphify-out/
**/target/
*.pyc
*.bak*
*.save*
*.local.*
.env*
/*/eww/control-center/scripts/fast-client
*.so
/*/hypr/workspaces.conf
/*/hypr/workspaces-state.css
/*/waybar/workspaces-state.css
/*/hypr/local.conf
/*/hypr/local.lua
nvim.log

